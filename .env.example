# Server runtime required for the private Phase 3 CMS (never commit .env.local)
DATABASE_URL=postgresql://username:password@localhost:5432/portfolio
APP_ORIGIN=http://localhost:3000
ADMIN_EMAIL=your-admin-email@example.com
OTP_PEPPER=
RESEND_API_KEY=
OTP_FROM_EMAIL=Portfolio OTP <login@your-verified-domain.example>

# Optional gallery/résumé media uploads (public/readable bucket)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-media

# Bujji: server-only. Never prefix these with NEXT_PUBLIC_.
# Without a Groq key, Bujji uses the published notebook's deterministic answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional shared rate limit (recommended for a public serverless deployment).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
