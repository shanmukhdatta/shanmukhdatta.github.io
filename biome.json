{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "app/**",
      "components/**",
      "content/**",
      "lib/**",
      "scripts/**",
      "tests/**",
      "middleware.ts",
      "next.config.ts",
      "playwright.config.ts",
      "vitest.config.mts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": { "noUnreachable": "error", "noUnsafeFinally": "error" },
      "suspicious": { "noDebugger": "error", "noDuplicateObjectKeys": "error" }
    }
  },
  "assist": { "enabled": false }
}
